<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%date{ISO8601} %-5level %logger - %msg%n</pattern>
    </encoder>
  </appender>
  <logger name="datomic.peer" level="INFO" />
  <root level="WARN">
    <appender-ref ref="STDERR" />
  </root>
</configuration>
